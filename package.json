{
  "name": "eiip",
  "version": "1.1.0",
  "description": "EIIP (Elite India Image Processing) - Complete client-side image processing library with SVG/raster conversion, layer merging, image cropping, effects/filters, and PDF conversion. Compatible with React, Angular, Vue.js, and vanilla JavaScript.",
  "main": "eiip.js",
  "browser": "eiip.min.js",
  "unpkg": "eiip.min.js",
  "jsdelivr": "eiip.min.js",
